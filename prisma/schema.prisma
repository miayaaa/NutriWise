generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map(name: "user_id")
  type              String
  provider          String
  providerAccountId String   @map(name: "provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @updatedAt @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map(name: "accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map(name: "session_token")
  userId       String   @map(name: "user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map(name: "email_verified")
  image         String?
  dailyCalorieGoal Int?      @map(name: "daily_calorie_goal")
  dailyWaterGoal   Int       @default(2000) @map(name: "daily_water_goal")
  heightCm         Int?      @map(name: "height_cm")
  weightGoalKg     Float?    @map(name: "weight_goal_kg")
  fastingEnabled   Boolean   @default(false) @map(name: "fasting_enabled")
  fastingStart     Int       @default(12) @map(name: "fasting_start")
  fastingEnd       Int       @default(20) @map(name: "fasting_end")
  createdAt        DateTime  @default(now()) @map(name: "created_at")
  updatedAt        DateTime  @updatedAt @map(name: "updated_at")

  accounts    Account[]
  sessions    Session[]
  activities  Activity[]
  foodLogs    FoodLog[]
  waterLogs   WaterLog[]
  weightLogs  WeightLog[]
  workoutLogs WorkoutLog[]
  coachInsights CoachInsight[]

  @@map(name: "users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_tokens")
}

model Activity {
  id          String   @id @default(cuid())
  userId      String   @map(name: "user_id")
  name        String
  description String?
  colorCode   String   @map(name: "color_code")
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id])

  activityLogs ActivityLog[]

  @@map(name: "activities")
}

model ActivityLog {
  id              String   @id @default(cuid())
  activityId      String   @map(name: "activity_id")
  date            DateTime @default(now())
  count           Int      @default(1)
  foodDescription String?  @map(name: "food_description") @db.Text
  aiCalories      Float?   @map(name: "ai_calories")

  activity Activity @relation(fields: [activityId], references: [id])

  @@map(name: "activity_log")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model FoodLog {
  id              String   @id @default(cuid())
  userId          String   @map(name: "user_id")
  date            DateTime @default(now())
  mealType        MealType @default(SNACK) @map(name: "meal_type")
  foodDescription String   @map(name: "food_description") @db.Text
  aiCalories      Float?   @map(name: "ai_calories")
  protein         Float?
  carbs           Float?
  fat             Float?
  aiComment       String?  @map(name: "ai_comment") @db.Text
  createdAt       DateTime @default(now()) @map(name: "created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "food_logs")
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String   @map(name: "user_id")
  amount    Int      // ml
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "water_logs")
}

model WeightLog {
  id       String   @id @default(cuid())
  userId   String   @map(name: "user_id")
  weightKg Float    @map(name: "weight_kg")
  date     DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "weight_logs")
}

model WorkoutLog {
  id          String   @id @default(cuid())
  userId      String   @map(name: "user_id")
  type        String
  durationMin Int      @map(name: "duration_min")
  details     Json?
  notes       String?  @db.Text
  aiComment   String?  @map(name: "ai_comment") @db.Text
  date        DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "workout_logs")
}

model CoachInsight {
  id           String   @id @default(cuid())
  userId       String   @map(name: "user_id")
  rangeType    String   @map(name: "range_type")
  startDate    DateTime @map(name: "start_date")
  endDate      DateTime @map(name: "end_date")
  summary      String   @db.Text
  coachComment String   @map(name: "coach_comment") @db.Text
  actionItems  Json     @map(name: "action_items")
  score        Int
  generatedAt  DateTime @default(now()) @map(name: "generated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rangeType, startDate, endDate])
  @@map(name: "coach_insights")
}
